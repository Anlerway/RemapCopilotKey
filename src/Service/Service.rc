// ---------------------------------------------------------------------------
// RemapCopilotKey 服务程序的版本资源
//
// 这个文件刻意只写 ASCII。rc.exe 默认按系统代码页解释 .rc，
// 混入 UTF-8 中文很容易出现乱码，所以这里只写 ASCII。
// ---------------------------------------------------------------------------

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Anlerway"
            VALUE "FileDescription",  "RemapCopilotKey Service"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "RemapCopilotKeyService"
            VALUE "LegalCopyright",   "https://github.com/Anlerway/RemapCopilotKey"
            VALUE "OriginalFilename", "RemapCopilotKeyService.exe"
            VALUE "ProductName",      "RemapCopilotKey"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "https://github.com/Anlerway/RemapCopilotKey"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
