<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
      type="win32"
      name="RemapCopilotKey.Service"
      version="1.0.0.0"
      processorArchitecture="*"/>

  <description>RemapCopilotKey Service</description>

  <!--
    固定声明"需要管理员"，对两种跑法各有用处：

    1. 钩子进程（默认跑法，跑在用户会话里，真正装 WH_KEYBOARD_LL 的那个）：
       低级键盘钩子受 UIPI 限制，非提升进程看不到送往提升窗口的输入，所以
       它必须是高完整性。配置程序手动"启动服务"时由此触发 UAC；
       开机自启时由服务宿主用用户完整令牌 CreateProcessAsUser 拉起，
       令牌本身已提权，不会再弹 UAC。

    2. 服务宿主（service 模式，由 SCM 以 LocalSystem 启动）：
       UAC 清单**不参与**服务的启动 —— SCM 用自己的服务令牌直接
       CreateProcess，不经过 AppInfo 提权，所以这里声明什么都没关系，
       服务照样以 SYSTEM 起来。（反过来说，这个清单不能用来"给服务提权"，
       服务的权限完全由服务账户决定。）

    开机自启的实现见 src/Configurator/ServiceInstaller.cs（注册 SCM 服务）
    与 src/Service/src/ServiceHost.cpp（服务宿主把钩子投递进用户会话）。

    注意：这里的"管理员权限"是**服务自身**的。配套界面里那个"以管理员权限运行"
    开关控制的是**被打开的目标程序**是否需要提权（ShellExecute 的 runas 动词）。
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
