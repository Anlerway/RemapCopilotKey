# ---------------------------------------------------------------------------
# 强制行尾约定
#
# cmd.exe 用 OEM 代码页逐行解析 .cmd/.bat；只有 LF 行尾时会出现
# goto 标签错乱、行被拼接等诡异问题（本项目踩过）。这里强制 CRLF，
# 保证任何人 clone 下来都能直接双击运行构建脚本。
# ---------------------------------------------------------------------------

* text=auto

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

*.sln        text eol=crlf
*.vcxproj    text eol=crlf
*.vcxproj.filters text eol=crlf
*.csproj     text eol=crlf
*.props      text eol=crlf
*.targets    text eol=crlf

*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.cs   text eol=lf
*.md   text eol=lf
*.json text eol=lf

# 二进制资源
*.ico  binary
*.png  binary
*.bmp  binary
*.res  binary
